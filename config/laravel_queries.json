          "type": "integer",
          "required": true,
          "description": "Order ID"
        },
        "user_id": {
          "type": "integer",
          "required": false,
          "description": "User ID for access control"
        }
      },
      "query_template": {
        "sql": "SELECT id, user_id, total, status FROM orders WHERE id = :order_id AND (:user_id IS NULL OR user_id = :user_id) LIMIT 1",
